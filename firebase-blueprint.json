{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile and sync metadata",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Google Auth User ID" },
        "displayName": { "type": "string", "description": "Display name of the user" },
        "email": { "type": "string", "description": "Email address of the user" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via serverTimestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp via serverTimestamp" }
      },
      "required": ["userId", "createdAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Chat message authored by the user or generated by AI assistant",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner user ID" },
        "sender": { "type": "string", "enum": ["user", "ai", "system"], "description": "Message sender" },
        "text": { "type": "string", "description": "Content of the message" },
        "hasSources": { "type": "boolean", "description": "Whether message contains web sources" },
        "sourcesJson": { "type": "string", "description": "JSON string representation of web search sources" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via serverTimestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp via serverTimestamp" }
      },
      "required": ["userId", "sender", "text", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile document"
    },
    "/users/{userId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "User chat messages subcollection"
    }
  }
}
