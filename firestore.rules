rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidChatMessage(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.sender is string && (data.sender == 'user' || data.sender == 'ai' || data.sender == 'system') &&
             data.text is string && data.text.size() <= 50000 &&
             (!('hasSources' in data) || data.hasSources is bool) &&
             (!('sourcesJson' in data) || (data.sourcesJson is string && data.sourcesJson.size() <= 10000)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt']);

      allow delete: if isSignedIn() && request.auth.uid == userId;

      match /messages/{messageId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(messageId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'sender', 'text', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'sender', 'text', 'hasSources', 'sourcesJson', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         isValidChatMessage(incoming());

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(messageId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidChatMessage(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['text', 'hasSources', 'sourcesJson', 'updatedAt']);

        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}
